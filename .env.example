# Copia este archivo como .env y rellena tus claves.
# .env NUNCA se sube al repositorio (está en .gitignore).

# --- Stock de video/imagen (gratis) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Guionista IA (Fase 3) ---
ANTHROPIC_API_KEY=

# --- Imágenes IA (Fase 2) ---
FAL_KEY=

# --- Voz premium (opcional, más adelante) ---
ELEVENLABS_API_KEY=

# --- Rutas (opcional: solo si FFmpeg no está en el PATH) ---
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# --- Render ---
# auto = usa NVENC si hay GPU NVIDIA, si no cae a libx264
ENCODER=auto
