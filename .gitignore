# === SECRETOS — nunca al repositorio ===
.env
*client_secret*.json
*token*.json
credentials.json

# === Salidas y material pesado ===
nichos/*/output/
trabajo/
cache/
*.mp4
*.mov
*.mkv
*.mp3
*.wav
*.m4a
